# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,yml,yaml,json,css,html}]
indent_size = 2

[*.md]
# Trailing whitespace is significant in Markdown line breaks.
trim_trailing_whitespace = false

[{mvnw,mvnw.cmd,mvnwDebug,mvnwDebug.cmd}]
# Maintained upstream by the Maven Wrapper; don't reformat.
indent_style = unset
indent_size = unset
insert_final_newline = unset
